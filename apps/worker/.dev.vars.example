# Optional server-owned profiles. Store real values with `wrangler secret put`.
# SERVER_AI_PROFILES_JSON=[{"profile":{"id":"server-fast","label":"Server AI","protocol":"openai-compatible","execution":"server","baseUrl":"https://api.example.com/v1","model":"vision-model","capabilities":{"vision":true,"structuredOutput":"json-schema","observationMode":"checkpoint","maxObservationPasses":1},"secretRef":"server-fast","enabled":true},"apiKey":"replace-me"}]

# Optional built-in MiniMax-M3 server profile.
# MINIMAX_API_KEY=replace-me
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MODEL=MiniMax-M3[1M]
# MINIMAX_MAX_OBSERVATION_PASSES=2

# Optional Cloudflare Realtime TURN credentials.
# TURN_KEY_ID=replace-me
# TURN_KEY_API_TOKEN=replace-me
