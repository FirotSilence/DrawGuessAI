# CCSwitch capabilities describe whichever provider is currently active. The model
# itself is selected in CCSwitch and is deliberately not shown by DrawGuessAI.
VITE_CCSWITCH_VISION=true
VITE_CCSWITCH_MAX_OBSERVATION_PASSES=2
VITE_CCSWITCH_REASONING_MODE=disabled

# Local development only. Prefer a user-level DEEPSEEK_API_KEY environment variable
# instead of writing the token here. Official DeepSeek V4 is text-only.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=DeepSeek-V4-Flash
